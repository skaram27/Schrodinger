import os
import numpy as np
import scipy.linalg as la
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

def get_bit(state, site):
    return (state >> site) & 1

def flip_bit(state, site):
    return state ^ (1 << site)

def count_magnon(state):
    return bin(state).count("1")

def state_label(state, num_sites):
    return format(state, f"0{num_sites}b")[::-1]

def build_basis(num_sites):
    return [0] + [1 << i for i in range(num_sites)] + [(1 << i) | (1 << j) for i in range(num_sites) for j in range(i + 1, num_sites)]

Z = np.array([[-1,0], [0,1]], dtype=complex)
X = np.array([[0,1], [1,0]], dtype=complex)

def onsite_hamiltonian(omega=1):
    return omega * Z

def bond_hamiltonian(jxy=1, jz=1):
    return np.array([[jz, 0, 0, 0], [0, -jz, 2*jxy, 0], [0, 2*jxy, -jz, 0], [0, 0, 0, jz]], dtype=complex)

def build_static_unitaries(basis, num_sites, dr, omega=1, jxy=1, jz=1):
    onsite_eigens = np.array([omega *(2*count_magnon(state)-num_sites) for state in basis])
    onsite_half = np.exp(-1.0j*onsite_eigens*(dr/2))
    onsite_half_dag = onsite_half.conj()

    bond_half = la.expm(-1.0j * bond_hamiltonian(jxy, jz) * (dr / 2.0))
    bond_half_dag = bond_half.conj().T

    return onsite_half, bond_half, onsite_half_dag, bond_half_dag

def build_state_index(basis):
    return {state: idx for idx, state in enumerate(basis)}

def apply_bond_half(psi, basis, state_to_idx, site, bond_half):
    new_psi = psi.copy()
    aligned_phase = bond_half[0,0]
    pair_unitary = bond_half[1:3,1:3]

    for index, state in enumerate(basis):
        bit1 = get_bit(state, site)
        bit2 = get_bit(state, site+1)

        if bit1==bit2:
            new_psi[index] = aligned_phase*psi[index]
        elif bit1==1 and bit2==0:
            swapped = flip_bit(flip_bit(state,site), site+1)
            partner_index = state_to_idx[swapped]

            local_psi = np.array([psi[index], psi[partner_index]])

            new_local_psi = pair_unitary @ local_psi
            new_psi[index] = new_local_psi[0]
            new_psi[partner_index] = new_local_psi[1]

    return new_psi
