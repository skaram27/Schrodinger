import numpy as np
import scipy.linalg as la

class TrotterPropagator:
    def __init__(self, propagator, dt, n_substeps=1):
        self.propagator = propagator
        self.dt = dt
        self.n_substeps = n_substeps
        self.dr = dt / n_substeps
        self.dim = propagator.dim

        self.h0 = propagator.H0()
        self.mu_x = propagator.controlH(site=0, pauli_type='x')
        self.mu_z = propagator.controlH(site=0, pauli_type='z')

        self.local_static_terms = propagator.local_staticH()

        self.half_step_unitaries = [la.expm(-1.0j * h_l * (self.dr / 2.0)) for h_l in self.local_static_terms]

    def step_exact(self, psi, eps_x, eps_z):
        h_total = self.h0 + eps_x * self.mu_x + eps_z * self.mu_z
        u_step = la.expm(-1.0j * h_total * self.dt)
        return u_step @ psi

    def step_trotter(self, psi, eps_x, eps_z):
        state = psi.copy()

        h_ctrl = eps_x * self.mu_x + eps_z * self.mu_z
        u_ctrl = la.expm(-1.0j * h_ctrl * self.dr)

        for _ in range(self.n_substeps):
            for u_half in self.half_step_unitaries:
                state = u_half @ state

            state = u_ctrl @ state

            for u_half in reversed(self.half_step_unitaries):
                state = u_half @ state

        return state
